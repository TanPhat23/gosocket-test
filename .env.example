# ==============================================================================
# Agent Task Manager - Environment Configuration Reference
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
PORT=8080

# PostgreSQL 18 Connection Settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_tasks?sslmode=disable
DATABASE_STATEMENT_TIMEOUT_SECONDS=15
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Redis 7 (Asynq Distributed Task Queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Encryption & Session Security
# SECRET_ENCRYPTION_KEY must be exactly 32 bytes (256 bits) for AES-256-GCM
SECRET_ENCRYPTION_KEY=01234567890123456789012345678901
SESSION_SECRET=dev-session-secret-minimum-32-chars-long

# Worker & Sandbox Constraints
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT_MINUTES=60
HOST_WORKTREE_ROOT=/tmp/agent-tasks/worktrees
HOST_REPO_ROOT=/tmp/agent-tasks/repos

# OIDC Authentication (Optional for local development)
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
