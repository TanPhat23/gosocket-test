# ==============================================================================
# Agent Task Manager - Environment Configuration Reference
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
PORT=8080

# PostgreSQL 18 Connection Settings
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_tasks?sslmode=disable
DATABASE_STATEMENT_TIMEOUT_SECONDS=15
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Redis 7 (Asynq Distributed Task Queue)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Encryption & Session Security
# SECRET_ENCRYPTION_KEY must be exactly 32 bytes (256 bits) for AES-256-GCM
SECRET_ENCRYPTION_KEY=01234567890123456789012345678901
SESSION_SECRET=dev-session-secret-minimum-32-chars-long

# Worker & Sandbox Constraints
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT_MINUTES=60
HOST_WORKTREE_ROOT=/home/ghug/Code/Go/agent-task-manager/data/worktrees
HOST_REPO_ROOT=/home/ghug/Code/Go/agent-task-manager/data/repos

# OpenCode Integration
OPENCODE_SERVER_URL=http://127.0.0.1:49374
OPENCODE_PASSWORD=4YXQ3udRl8k_UkFdyhHSFF-bdInQgKk0F9Qz6zp2y0U

# OIDC Authentication (Pre-configured out of the box with local Dex identity provider)
# Test accounts:
#   admin@example.com / password123
#   developer@example.com / password123
OIDC_ISSUER_URL=http://localhost/dex
OIDC_INTERNAL_ISSUER_URL=http://dex:5556/dex
OIDC_CLIENT_ID=agent-control-plane
OIDC_CLIENT_SECRET=dev-oidc-secret-change-in-prod-1234
OIDC_REDIRECT_URL=http://localhost/api/v1/auth/callback

# Ingress & Let's Encrypt SSL/TLS Configuration
DOMAIN=localhost
ACME_EMAIL=admin@agenttaskmanager.io
# For testing without hitting Let's Encrypt rate limits, uncomment staging:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ---------------------------------------------------------------------------------------------------------------
# Project-scoped container runtime (DISABLED; reference only)
#
# Nothing below is read by docker-compose.yml, so setting it here does not enable anything. The runtime stays
# quarantined in code (Phase 1A) until the qualification gates pass and the operator gives a separate go-ahead; the
# dev stack keeps using ATM_DEV_FAKE_RUNTIME. Every value must be real and operator-supplied:
#   - images are pinned by sha256 digest (no tags), never pulled at run time
#   - the gateway CA is the PUBLIC certificate only; the provider key is read from a file (ATM_GATEWAY_PROVIDER_KEY_FILE)
#   - the proxy and canary addresses are IP literals on the host-enforced sandbox firewall (Gate 0D)
#
# ATM_PROJECT_RUNTIME_ENABLED=true
# ATM_SANDBOX_GATEWAY_URL=https://<gateway-ip>:8082          # https only
# ATM_GATEWAY_CA_FILE=/etc/atm/gateway-ca.pem
# ATM_SANDBOX_PROXY_URL=http://<egress-proxy-ip>:3128         # IP literal
# ATM_EGRESS_VERIFY_IMAGE=<registry>/<probe-image>@sha256:<digest>
# ATM_EGRESS_CANARIES=<ipv4>:<port>,<ipv4>:<port>
# ATM_SANDBOX_CONTEXT_TOKENS=
# ATM_GATEWAY_MODELS=<model-id>
# ATM_GATEWAY_MAX_OUTPUT_TOKENS=
#
# Git transfer helper (Gate 0C)
# ATM_GIT_TRANSFER_ENABLED=true
# ATM_GIT_TRANSFER_IMAGE=<registry>/<git-transfer>@sha256:<digest>
#
# LLM gateway (Gate 0G); see deploy/gateway/qualify/start.sh for a working shape
# ATM_GATEWAY_ENABLED=true
# ATM_GATEWAY_LISTEN_ADDR=<gateway-ip>:8082
# ATM_GATEWAY_UPSTREAM_URL=https://<provider>/v1/chat/completions
# ATM_GATEWAY_PROVIDER_KEY_FILE=/run/secrets/provider.key
# ATM_GATEWAY_TLS_CERT_FILE=/etc/atm/gateway.pem
# ATM_GATEWAY_TLS_KEY_FILE=/etc/atm/gateway.key
# ATM_GATEWAY_PRICE_FILE=/etc/atm/prices.json
# ATM_GATEWAY_QUOTA_USD=
# ATM_GATEWAY_TOKEN_SECRET=<at least 32 random bytes; operator-generated, never commit>
