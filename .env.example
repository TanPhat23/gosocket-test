# Domain & Edge Proxy (Traefik)
DOMAIN=tasks.example.com
ACME_EMAIL=ops@example.com

# Application Environment & Server
APP_ENV=development
PORT=8080

# PostgreSQL Database
POSTGRES_DB=agent_tasks
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=generate_secure_random_db_password
DATABASE_URL=postgres://agent_user:generate_secure_random_db_password@localhost:5432/agent_tasks?sslmode=disable

# Redis & Asynq Queue
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=generate_secure_redis_password

# Cryptographic Keys (Master Secrets)
# Must be exactly 32 bytes (256-bit) for AES-256-GCM encryption
SECRET_ENCRYPTION_KEY=01234567890123456789012345678901
SESSION_SECRET=generate_32_byte_base64_session_key

# Task Execution & Concurrency
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT_MINUTES=60
TASK_LEASE_TIMEOUT_SECONDS=120
TASK_POLL_INTERVAL_MS=1000

# Host Paths (for Docker-out-of-Docker Worktree Isolation)
HOST_WORKTREE_ROOT=/srv/agent-tasks/worktrees
HOST_REPO_ROOT=/srv/agent-tasks/repos

# OIDC Authentication (OAuth 2.1 / PKCE)
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/callback
